{
    "name": "@tokensapi/dsh-login",
    "version": "0.1.1",
    "description": "TokensAPI account sign-in for DeepSeek Harness Desktop: log in with the TokensAPI account system (password, Google/OAuth, wallet), then provision the API key automatically for the managed model plugins",
    "type": "module",
    "scripts": {
        "test": "node --test",
        "check": "node --test",
        "prepack": "npm run check"
    },
    "files": [
        "dsh",
        "cordis.patch.yml",
        "README.md",
        "README.zh-CN.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "keywords": [
        "tokensapi",
        "login",
        "oauth",
        "dsh",
        "cordis"
    ],
    "author": "TokensAPI contributors",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TokensAPI/tokens_DshLogin_code.git"
    },
    "bugs": {
        "url": "https://github.com/TokensAPI/tokens_DshLogin_code/issues"
    },
    "homepage": "https://github.com/TokensAPI/tokens_DshLogin_code#readme",
    "publishConfig": {
        "registry": "https://npm.tokensapi.ai/"
    },
    "engines": {
        "node": ">=22.19"
    },
    "exports": {
        ".": "./dsh/index.js",
        "./dsh": "./dsh/index.js",
        "./package.json": "./package.json",
        "./client": "./dsh/client.js"
    },
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "inject": [],
            "platform": "web",
            "immediately": true
        }
    }
}
